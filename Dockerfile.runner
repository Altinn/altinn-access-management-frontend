FROM ghcr.io/altinn/altinn-platform/gh-runner:v0.10.0

USER root

WORKDIR /tmp/playwright-install

COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn/ .yarn/
COPY playwright/package.json ./playwright/package.json

RUN yarn install --immutable && \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    yarn workspace playwright exec playwright install --with-deps && \
    rm -rf /tmp/playwright-install && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# /tmp/playwright-install slettes i RUN-steget over, så cwd må settes tilbake til
# runner-hjemmet – ellers finner ikke containeren ./entrypoint.sh ved oppstart.
WORKDIR /home/runner

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

RUN chmod -R 755 /ms-playwright

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

USER runner